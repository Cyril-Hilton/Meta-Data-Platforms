APP_ENV=local
APP_URL=http://127.0.0.1:8789

# Local/dev should use Paystack test keys.
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Product prices always display in dollars.
# Keep USD as the first checkout attempt. If the merchant account cannot accept USD,
# the backend falls back to GHS using the live exchange-rate API below.
PAYSTACK_CHARGE_CURRENCY=USD
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# Emergency fallback only if the live API and saved fallback cache are unavailable.
PAYSTACK_USD_TO_GHS_RATE=11.08

RECEIPT_FROM_EMAIL=receipts@metadataplatforms.9yttrybe.com
SUPPORT_EMAIL=billing@metadataplatforms.9yttrybe.com
